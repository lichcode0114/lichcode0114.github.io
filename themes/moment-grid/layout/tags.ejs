<%
const allTags = site.tags.sort('name');
%>

<div class="archive-hero">
  <div class="section-inner">
    <h1>标签</h1>
    <p>按标签浏览所有文章 · 共 <%= allTags.length %> 个标签</p>
  </div>
</div>

<section class="section">
  <div class="section-inner">
    <div class="tags-cloud-wrapper">
      <% allTags.each(function(tag) { %>
        <a href="<%- url_for(tag.path) %>" class="tag-cloud-item" data-count="<%= tag.posts.length %>">
          <span class="tag-name"><%= tag.name %></span>
          <span class="tag-count"><%= tag.posts.length %></span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<style>
.tags-cloud-wrapper {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  padding: 20px 0;
}

.tag-cloud-item {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border: 1px solid rgba(8, 145, 178, 0.2);
  border-radius: 999px;
  color: var(--teal);
  font-weight: 600;
  text-decoration: none;
  transition: all 0.3s ease;
  box-shadow: 0 2px 8px rgba(30, 58, 95, 0.1);
}

.tag-cloud-item:hover {
  transform: translateY(-2px);
  background: rgba(240, 249, 255, 0.95);
  border-color: rgba(8, 145, 178, 0.4);
  box-shadow: 0 4px 16px rgba(8, 145, 178, 0.2);
}

.tag-name {
  font-size: 15px;
}

.tag-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 24px;
  height: 24px;
  padding: 0 8px;
  background: linear-gradient(135deg, var(--mint), var(--blue));
  color: white;
  font-size: 12px;
  font-weight: 700;
  border-radius: 12px;
}
</style>
