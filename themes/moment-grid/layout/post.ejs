<%
const categoryName = page.categories && page.categories.length ? page.categories.first().name : '实验文章';
%>

<article class="article-page">
  <header class="article-hero">
    <div class="article-hero-inner">
      <div>
        <div class="meta-row article-meta">
          <span><%= date(page.date, 'YYYY-MM-DD') %></span>
          <span><%= categoryName %></span>
          <span><%= page.tags && page.tags.length ? page.tags.length + ' 个标签' : '技术笔记' %></span>
        </div>
        <h1><%= page.title %></h1>
        <% if (page.excerpt) { %><p><%= strip_html(page.excerpt).replace(/\s+/g, ' ').trim() %></p><% } %>
      </div>
      <img src="<%- url_for(page.cover || '/images/bearing-wave.svg') %>" alt="<%= page.title %>">
    </div>
  </header>

  <div class="article-shell-wrapper">
    <div class="article-shell">
      <aside class="toc-panel">
        <strong>文章导航</strong>
        <%- toc(page.content, { list_number: false, max_depth: 3 }) %>
      </aside>
      <div class="article-body">
        <%- page.content %>
      </div>
    </div>

    <!-- 右侧互动区域 -->
    <aside class="article-sidebar">
      <!-- 浮动按钮组 -->
      <div class="floating-buttons">
        <button class="float-btn support-float" onclick="togglePanel('support')" title="支持博主">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
          </svg>
        </button>

        <button class="float-btn actions-float" onclick="togglePanel('actions')" title="互动">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
          </svg>
        </button>

        <button class="float-btn comments-float" onclick="togglePanel('comments')" title="评论">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
          </svg>
        </button>
      </div>

      <!-- 支持博主面板 -->
      <div class="sidebar-panel support-panel" id="support-panel">
        <button class="close-panel" onclick="closePanel('support')">×</button>
        <div class="support-card">
          <div class="support-header">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <h3>支持博主</h3>
          </div>
          <p>如果这篇文章对你有帮助，欢迎请博主喝杯咖啡~</p>
          <div class="qrcode-placeholder">
            <img src="<%- url_for('/images/reward-qr.jpg') %>" alt="支持博主" onerror="this.parentElement.innerHTML='<p style=\'color:#94a3b8;font-size:14px;\'>暂未设置收款码</p>'">
          </div>
        </div>
      </div>

      <!-- 互动面板 -->
      <div class="sidebar-panel actions-panel" id="actions-panel">
        <button class="close-panel" onclick="closePanel('actions')">×</button>
        <div class="article-actions">
          <button class="action-btn like-btn" onclick="handleLike()" title="点赞">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path>
            </svg>
            <span class="action-count" id="like-count" aria-label="点赞数">0</span>
          </button>

          <button class="action-btn favorite-btn" onclick="handleFavorite()" title="收藏">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
            </svg>
            <span class="action-count" id="favorite-count" aria-label="收藏数">0</span>
          </button>

          <button class="action-btn share-btn" onclick="handleShare()" title="分享">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="18" cy="5" r="3"></circle>
              <circle cx="6" cy="12" r="3"></circle>
              <circle cx="18" cy="19" r="3"></circle>
              <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
              <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
            </svg>
          </button>
        </div>
      </div>

      <!-- 评论面板 -->
      <div class="sidebar-panel comments-panel" id="comments-panel">
        <button class="close-panel" onclick="closePanel('comments')">×</button>
        <div class="comments-card">
          <h3>讨论</h3>
          <a href="https://github.com/lichcode0114/lichcode0114.github.io/issues" target="_blank" rel="noopener noreferrer">前往 GitHub 交流</a>
        </div>
      </div>
    </aside>
  </div>
</article>

<script>
// 互动功能
// 面板控制
function togglePanel(panelType) {
  const panel = document.getElementById(`${panelType}-panel`);

  // 切换当前面板（不关闭其他面板）
  panel.classList.toggle('active');

  // 如果是评论面板且正在打开，滚动到顶部
  if (panelType === 'comments' && panel.classList.contains('active')) {
    setTimeout(() => {
      panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 300);
  }
}

function closePanel(panelType) {
  const panel = document.getElementById(`${panelType}-panel`);
  panel.classList.remove('active');
}

// 页面加载时默认展开所有面板
window.addEventListener('DOMContentLoaded', function() {
  // 默认展开所有面板
  document.getElementById('support-panel').classList.add('active');
  document.getElementById('actions-panel').classList.add('active');
  document.getElementById('comments-panel').classList.add('active');

  // 恢复互动状态和计数（需要在面板展开后）
  setTimeout(() => {
    const likeBtn = document.querySelector('.like-btn');
    const favoriteBtn = document.querySelector('.favorite-btn');
    const likeCountEl = document.getElementById('like-count');
    const favoriteCountEl = document.getElementById('favorite-count');

    // 恢复点赞状态和计数
    if (isActive('like')) {
      likeBtn.classList.add('active');
    }
    likeCountEl.textContent = getCount('like');

    // 恢复收藏状态和计数
    if (isActive('favorite')) {
      favoriteBtn.classList.add('active');
    }
    favoriteCountEl.textContent = getCount('favorite');
  }, 100);
});

// 获取文章唯一标识
const articleId = location.pathname;

// 获取或初始化计数
function getCount(type) {
  const key = `${type}-count-${articleId}`;
  const count = localStorage.getItem(key);
  return count ? parseInt(count) : 0;
}

// 保存计数
function saveCount(type, count) {
  const key = `${type}-count-${articleId}`;
  localStorage.setItem(key, count.toString());
}

// 检查状态
function isActive(type) {
  const key = `${type}-${articleId}`;
  return localStorage.getItem(key) === 'true';
}

// 保存状态
function saveState(type, active) {
  const key = `${type}-${articleId}`;
  if (active) {
    localStorage.setItem(key, 'true');
  } else {
    localStorage.removeItem(key);
  }
}

function handleLike() {
  const btn = document.querySelector('.like-btn');
  const countEl = document.getElementById('like-count');
  let currentCount = getCount('like');
  const wasActive = isActive('like');

  if (wasActive) {
    // 取消点赞
    btn.classList.remove('active');
    currentCount = Math.max(0, currentCount - 1);
    saveState('like', false);
  } else {
    // 点赞
    btn.classList.add('active');
    currentCount = currentCount + 1;
    saveState('like', true);
  }

  saveCount('like', currentCount);
  countEl.textContent = currentCount;
}

function handleFavorite() {
  const btn = document.querySelector('.favorite-btn');
  const countEl = document.getElementById('favorite-count');
  let currentCount = getCount('favorite');
  const wasActive = isActive('favorite');

  if (wasActive) {
    // 取消收藏
    btn.classList.remove('active');
    currentCount = Math.max(0, currentCount - 1);
    saveState('favorite', false);
  } else {
    // 收藏
    btn.classList.add('active');
    currentCount = currentCount + 1;
    saveState('favorite', true);
  }

  saveCount('favorite', currentCount);
  countEl.textContent = currentCount;
}

function handleShare() {
  const url = location.href;
  const title = document.title;

  // 优先使用原生分享 API（移动端）
  if (navigator.share) {
    navigator.share({
      title: title,
      url: url
    }).then(() => {
      // 分享成功，不显示任何提示
      console.log('分享成功');
    }).catch((error) => {
      // 用户取消分享，不显示错误
      if (error.name !== 'AbortError') {
        // 只有非取消的错误才提示
        console.log('分享失败', error);
      }
    });
  } else {
    // 降级方案：复制链接到剪贴板
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url).then(() => {
        showShareToast('链接已复制到剪贴板！');
      }).catch(() => {
        fallbackCopyText(url);
      });
    } else {
      fallbackCopyText(url);
    }
  }
}

// 降级复制方法
function fallbackCopyText(text) {
  const textarea = document.createElement('textarea');
  textarea.value = text;
  textarea.style.position = 'fixed';
  textarea.style.opacity = '0';
  document.body.appendChild(textarea);
  textarea.select();

  try {
    document.execCommand('copy');
    showShareToast('链接已复制到剪贴板！');
  } catch (err) {
    showShareToast('复制失败，请手动复制链接');
  }

  document.body.removeChild(textarea);
}

// 显示分享提示
function showShareToast(message) {
  // 创建提示元素
  const toast = document.createElement('div');
  toast.className = 'share-toast';
  toast.textContent = message;
  document.body.appendChild(toast);

  // 触发动画
  setTimeout(() => toast.classList.add('show'), 10);

  // 2秒后移除
  setTimeout(() => {
    toast.classList.remove('show');
    setTimeout(() => document.body.removeChild(toast), 300);
  }, 2000);
}

// 加载用户之前的互动状态
window.addEventListener('DOMContentLoaded', function() {
  const likeBtn = document.querySelector('.like-btn');
  const favoriteBtn = document.querySelector('.favorite-btn');
  const likeCountEl = document.getElementById('like-count');
  const favoriteCountEl = document.getElementById('favorite-count');

  // 恢复点赞状态和计数
  if (isActive('like')) {
    likeBtn.classList.add('active');
  }
  likeCountEl.textContent = getCount('like');

  // 恢复收藏状态和计数
  if (isActive('favorite')) {
    favoriteBtn.classList.add('active');
  }
  favoriteCountEl.textContent = getCount('favorite');
});
</script>
