<%
const posts = site.posts.sort('-date').toArray();
const featured = posts[0];
const featuredUrl = featured ? url_for(featured.path) : '#';
function cleanText(value) {
  return strip_html(value || '').replace(/\s+/g, ' ').trim();
}
function postExcerpt(post) {
  return cleanText(post.excerpt || post.content || post.description || '').slice(0, 118);
}

// 获取博客统计信息
const totalPosts = site.posts.length;
const totalCategories = site.categories.length;
const totalTags = site.tags.length;
%>

<section class="hero">
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="eyebrow"><span></span> LiCode · 技术分享</p>
      <h1><%= config.title %>：<%= config.subtitle %></h1>
      <p class="lead">在这里分享时序大模型、工业运维、深度学习、软件开发等各种技术领域的实践经验和知识总结。</p>
      <div class="hero-actions">
        <a class="button primary" href="<%- featuredUrl %>">阅读精选文章</a>
        <a class="button" href="<%- url_for('/about/') %>">了解更多</a>
      </div>
    </div>
    <div class="hero-visual" aria-label="LiCode 技术分享">
      <img src="<%- url_for('/images/licode-logo.png') %>" alt="LiCode 技术分享" onerror="this.src='<%- url_for('/images/bearing-wave.svg') %>'">
    </div>
  </div>
</section>

<section class="section featured-section" id="featured">
  <div class="section-inner">
    <div class="section-heading">
      <span class="section-kicker">Featured Article</span>
      <h2>精选文章</h2>
      <p>最新的技术分享和实验总结，深入探讨各个技术领域的实践经验。</p>
    </div>

    <div class="featured-layout">
      <% if (featured) { %>
      <article class="featured-card">
        <a class="cover-link" href="<%- url_for(featured.path) %>">
          <img src="<%- url_for(featured.cover || '/images/bearing-wave.svg') %>" alt="<%= featured.title %>">
        </a>
        <div class="featured-content">
          <div class="meta-row">
            <span><%= date(featured.date, 'YYYY-MM-DD') %></span>
            <% if (featured.categories && featured.categories.length) { %><span><%= featured.categories.first().name %></span><% } %>
            <% if (featured.tags && featured.tags.length) { %><span><%= featured.tags.first().name %></span><% } %>
          </div>
          <h3><a href="<%- url_for(featured.path) %>"><%= featured.title %></a></h3>
          <p><%= postExcerpt(featured) %></p>
          <a class="text-link" href="<%- url_for(featured.path) %>">进入文章正文</a>
        </div>
      </article>
      <% } %>

      <aside class="insight-panel" aria-label="博客统计信息">
        <div>
          <span class="panel-label">文章总数</span>
          <strong><%= totalPosts %> 篇技术文章</strong>
        </div>
        <div>
          <span class="panel-label">分类数量</span>
          <strong><%= totalCategories %> 个分类</strong>
        </div>
        <div>
          <span class="panel-label">标签数量</span>
          <strong><%= totalTags %> 个标签</strong>
        </div>
      </aside>
    </div>
  </div>
</section>

<section class="section dark-section" id="grid">
  <div class="section-inner">
    <div class="section-heading">
      <span class="section-kicker">Navigation Grid</span>
      <h2>文章导航</h2>
      <p>快速浏览各个技术主题，点击卡片进入对应文章详情。</p>
    </div>

    <div class="path-grid">
      <% posts.slice(0, 4).forEach(function(post, index) { %>
      <a class="path-card" href="<%- url_for(post.path) %>">
        <span><%= String(index + 1).padStart(2, '0') %></span>
        <h3><%= post.title.length > 20 ? post.title.slice(0, 20) + '...' : post.title %></h3>
        <p><%= postExcerpt(post).slice(0, 60) %>...</p>
      </a>
      <% }) %>
    </div>
  </div>
</section>
